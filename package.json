{
  "name": "wippaagent",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "wippaAGENT — one primary agent, twelve subagents, three MCP servers. The only OpenCode setup you need.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wippa-studios/wippaAGENT.git"
  },
  "keywords": [
    "opencode",
    "agents",
    "subagents",
    "wippa",
    "mcp",
    "orchestration"
  ],
  "scripts": {
    "test": "node --test \"**/*.test.ts\"",
    "eval": "node evals/run.ts",
    "check:claims": "node scripts/check-claims.mjs",
    "check:tokens": "node scripts/token-count.mjs --max 35000 --max-skills 1250 --max-agent 3000",
    "check:smoke": "node scripts/opencode-smoke.mjs",
    "test:quiet": "node --test --test-reporter=dot \"**/*.test.ts\"",
    "wordmark": "node scripts/wordmark.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.2",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
