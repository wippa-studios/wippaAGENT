{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "wippaAGENT",
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "agents": {
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "build": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "experimental": {
    "subagent_depth": 1
  },
  "mcp": {
    "timeout": {
      "startup": 90000,
      "catalog": 45000
    },
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}",
          "X-MCP-Toolsets": "repos,issues,pull_requests,actions"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "--yes",
          "@playwright/mcp@0.0.83",
          "--isolated"
        ]
      }
    }
  },
  "plugins": [
    { "package": "./tools" }
  ],
  "skills": [
    "./skills"
  ]
}
