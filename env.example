# --- GitHub ---
# Must be exported in the shell, not just in .env — opencode.json substitutes it
# into the github MCP server configuration at startup.
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- wippaAGENT ---
# Agent registry owner/repo. Defaults to wippa-studios/wippaAGENT.
# Used by the orchestration-lead agent when it installs agents from the registry.
WIPPA_AGENT_REGISTRY=

# Directory the agent catalog is indexed from. Used by the tools plugin.
WIPPA_AGENT_DIR=

# Comma-separated agent ids that are expected to live in the user's own global
# configuration; they are exempt from roster drift reporting. Used by the tools
# plugin.
WIPPA_CUSTOM_AGENT_IDS=
